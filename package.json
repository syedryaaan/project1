{
  "name": "proshop",
  "version": "1.0.0",
  "description": "MERN shopping cart app",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server",
    "server": "nodemon backend/server",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "NPM_CONFIG_PRODUCTION=false npm install --prefix frontend --legacy-peer-deps && CI=false npm run build --prefix frontend",
    "test": "node --test backend/tests/*.test.js",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix frontend --legacy-peer-deps && CI=false npm run build --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariosknl/ProShop.git"
  },
  "author": "Marios Kanellopoulos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mariosknl/ProShop/issues"
  },
  "homepage": "https://github.com/mariosknl/ProShop#readme",
  "dependencies": {
    "axios": "^1.0.0",
    "bcryptjs": "^3.0.0",
    "colors": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.0.0",
    "express-async-handler": "^1.1.4",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14"
  }
}
