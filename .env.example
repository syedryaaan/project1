# NexaStore Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@cluster0.ageb2ld.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://syedryaaan_db_user:<YOUR_DB_PASSWORD>@cluster0.ageb2ld.mongodb.net/nexastore?retryWrites=true&w=majority

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a long random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>

# ─── PayPal ───────────────────────────────────────────────────────────────────
# Get this from https://developer.paypal.com/
PAYPAL_CLIENT_ID=<YOUR_PAYPAL_CLIENT_ID>

# ─── Frontend URL (production only) ──────────────────────────────────────────
# FRONTEND_URL=https://your-domain.com
