# NexaStore Environment Variables
# Copy this file to .env for local development and fill in your real values.
# NEVER commit .env to version control.

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexastore?retryWrites=true&w=majority

# ─── Application ──────────────────────────────────────────────────────────────
# Use 'development' locally and 'production' on Render
NODE_ENV=development
PORT=5001

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a long random secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>

# ─── PayPal (Optional) ────────────────────────────────────────────────────────
# Defaults to 'sb' (sandbox) if omitted
PAYPAL_CLIENT_ID=sb

# ─── Frontend URL (Optional, Production Cross-Origin Only) ────────────────────
# Only needed if frontend is hosted on a separate domain from the backend
# FRONTEND_URL=https://your-frontend-domain.com
